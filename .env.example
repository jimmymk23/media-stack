# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Storage (see mediactl) ---
# External SSD (main storage)
DATA_ROOT=/Volumes/MediaServer/data
# Temporary storage when the SSD is unplugged
INTERNAL_DATA_ROOT=/Users/you/media-stack-data
# Archive drive; leave empty to disable
ARCHIVE_ROOT=       # /Volumes/Archive/media-archive

# --- Radarr/Sonarr API keys (Settings > General > API Key) ---
# Used by mediactl AND passed to the recyclarr and unpackerr containers.
RADARR_API_KEY=
SONARR_API_KEY=
# Optional: Jellyfin (Dashboard > API Keys) for library refresh / init-archive
JELLYFIN_API_KEY=
JELLYFIN_MOVIES_LIBRARY=Movies
JELLYFIN_TV_LIBRARY=Shows
# Optional: qBittorrent WebUI login, only for `mediactl archive --remove-torrents`
QBIT_USER=
QBIT_PASSWORD=
# Note: MEDIACTL_RSYNC, MEDIACTL_MOVE_TIMEOUT and MEDIACTL_POLL_SECS are
# shell environment variables, NOT .env settings. Set them by prefixing the
# command, e.g. MEDIACTL_RSYNC=/opt/homebrew/bin/rsync ./mediactl sync --yes

# --- VPN and network (existing) ---
VPN_SERVICE_PROVIDER=protonvpn   # nordvpn, expressvpn, protonvpn, surfshark or custom
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
OPENVPN_USER=
OPENVPN_PASSWORD=
VPN_PORT_FORWARDING=on
SERVER_COUNTRIES= # =United States
SERVER_CITIES= # =New York
RADARR_STATIC_CONTAINER_IP=
SONARR_STATIC_CONTAINER_IP=
